{
	"name": "plantifiles-monorepo",
	"private": true,
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo build",
		"dev": "turbo build --filter=@plantifiles/core --filter=@plantifiles/db && turbo dev",
		"format": "biome format .",
		"format:fix": "biome format . --write",
		"lint": "biome lint . && turbo lint",
		"test": "turbo test",
		"test:e2e": "turbo build --filter=@plantifiles/core --filter=@plantifiles/db --filter=plantifiles && pnpm --filter @plantifiles/web test:e2e",
		"typecheck": "turbo typecheck",
		"db:generate": "pnpm --filter @plantifiles/db generate",
		"db:migrate:local": "pnpm --dir apps/web exec wrangler d1 migrations apply plantifiles-dev --env dev --local",
		"db:migrate:remote": "pnpm --dir apps/web exec wrangler d1 migrations apply plantifiles --remote",
		"changeset": "changeset",
		"release:version": "changeset version",
		"release:publish": "turbo build --filter=plantifiles && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@changesets/cli": "^3.0.1",
		"turbo": "^2.5.6",
		"typescript": "^6.0.2"
	}
}
