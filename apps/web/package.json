{
	"name": "@plantifiles/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*",
		"#vars": "./config.generated.ts"
	},
	"scripts": {
		"vars:gen": "vars gen config.vars --platform serverless",
		"dev": "VITE_LOCAL_DEV=true VITE_PUBLIC_URL=http://localhost:3000 vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build && tsc --noEmit",
		"build:dev": "CLOUDFLARE_ENV=dev vite build && tsc --noEmit",
		"preview": "vite preview --port 3000",
		"deploy": "pnpm build && wrangler deploy",
		"deploy:dev": "pnpm build:dev && wrangler deploy --env dev",
		"deploy:dry": "pnpm build && wrangler deploy --dry-run",
		"migrate:dev": "wrangler d1 migrations apply plantifiles-dev --env dev --remote",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"test:e2e": "LOCAL_DEV=true playwright test",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit"
	},
	"dependencies": {
		"@clerk/backend": "3.16.10",
		"@clerk/tanstack-react-start": "1.5.6",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@plantifiles/core": "workspace:*",
		"@plantifiles/db": "workspace:*",
		"@plantifiles/ui": "workspace:*",
		"@shikijs/engine-javascript": "4.4.3",
		"@shikijs/langs": "4.4.3",
		"@shikijs/rehype": "4.4.3",
		"@shikijs/themes": "4.4.3",
		"@tanstack/react-router": "1.170.25",
		"@tanstack/react-start": "1.168.42",
		"drizzle-orm": "0.45.2",
		"hast-util-to-jsx-runtime": "2.3.6",
		"lucide-react": "^0.468.0",
		"mermaid": "11.16.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"remark-mdx": "3.1.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"shiki": "4.4.3",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"unified": "11.0.5",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.51.2",
		"@playwright/test": "1.62.1",
		"@tailwindcss/vite": "^4.1.14",
		"@tanstack/router-cli": "1.167.27",
		"@types/hast": "^3.0.4",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"dotvars": "1.0.5",
		"miniflare": "5.20260804.0-alpha",
		"typescript": "^6.0.2",
		"vite": "8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "4.120.1"
	}
}
